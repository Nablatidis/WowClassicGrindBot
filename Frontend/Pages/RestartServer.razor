@page "/RestartServer"

@inject IHostApplicationLifetime lifetime
@inject NavigationManager NavigationManager
@inject IBotController botController

<h2>Restarting the server - press reload when prompted...</h2>

<LogComponent />

@code {

    // A browser left on this page reconnects after every restart, which used to
    // restart the server again in a loop. The server restarts inside the same
    // process, so this static survives it: right after a restart, just go home.
    private static readonly TimeSpan MinTimeBetweenRestarts = TimeSpan.FromSeconds(30);
    private static DateTime lastRestart = DateTime.MinValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (DateTime.UtcNow - lastRestart < MinTimeBetweenRestarts)
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
            return;
        }

        lastRestart = DateTime.UtcNow;
        this.botController.Shutdown();
        NavigationManager.NavigateTo("/", forceLoad: true);
        await Task.Delay(1500);
        lifetime.StopApplication();
    }
}
